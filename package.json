{
  "name": "android-app-template",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "expo": "~58.0.14",
    "expo-asset": "~58.0.16",
    "expo-constants": "~58.0.12",
    "expo-dev-client": "~58.0.14",
    "expo-linking": "~58.0.13",
    "expo-router": "~58.0.23",
    "expo-splash-screen": "~58.0.10",
    "expo-sqlite": "~58.0.13",
    "expo-status-bar": "~58.0.3",
    "expo-system-ui": "~58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^10.13.0",
    "eslint-config-expo": "^58.0.4",
    "expo-doctor": "^1.21.5",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.11",
    "react-test-renderer": "19.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "android:native": "expo run:android",
    "ios:native": "expo run:ios",
    "prebuild": "expo prebuild",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "jest",
    "test:ci": "jest --ci --runInBand --coverage",
    "check": "npm run typecheck && npm run lint && npm run test:ci && npm run test:integration && node --test scripts/check-release.test.mjs",
    "test:integration": "node --experimental-strip-types --test scripts/database.integration.test.mjs",
    "doctor": "expo-doctor",
    "export": "expo export --platform all",
    "build:android:preview": "npx --yes eas-cli@25.2.0 build --platform android --profile preview",
    "build:android:production": "npx --yes eas-cli@25.2.0 build --platform android --profile production",
    "build:ios:preview": "npx --yes eas-cli@25.2.0 build --platform ios --profile preview",
    "build:ios:production": "npx --yes eas-cli@25.2.0 build --platform ios --profile production",
    "submit:android": "npx --yes eas-cli@25.2.0 submit --platform android --profile production",
    "submit:ios": "npx --yes eas-cli@25.2.0 submit --platform ios --profile production",
    "release:check": "node scripts/check-release.mjs",
    "eas-build-post-install": "node scripts/check-release.mjs --if-production"
  },
  "engines": {
    "node": ">=22.13.0 <25"
  },
  "private": true
}
